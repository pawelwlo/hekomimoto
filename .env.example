# WordPress media (gallery) — optional override; defaults to hekomimoto.com
# WORDPRESS_API_URL=https://hekomimoto.com/wp-json/wp/v2

# Resend (quote + booking emails)
RESEND_API_KEY=re_xxxxxxxx
# After verifying hekomimoto.com in Resend:
# RESEND_FROM=Hekomimoto <kontakt@hekomimoto.com>
# Until then, use the test sender + your Resend account email as TO:
RESEND_FROM=Hekomimoto <onboarding@resend.dev>
RESEND_TO=you@example.com

# Booking admin (password gate — no customer accounts)
ADMIN_PASSWORD=change-me
# Optional separate signing secret; defaults to ADMIN_PASSWORD
# ADMIN_SESSION_SECRET=long-random-string

# Firebase Admin (local). Easiest: download a key JSON and point to it:
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Or paste the JSON as one line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Firebase (client / Analytics) — safe to expose as NEXT_PUBLIC_*
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyC6EtCf7BPP7NqbE7-K7XKj7OvPkz8iBfg
